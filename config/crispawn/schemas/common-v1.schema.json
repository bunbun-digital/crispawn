{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crispawn:config:common:1",
  "title": "CRISPAWN shared configuration definitions v1",
  "$comment": "Copyright (c) 2026 bunbun-liveos contributors. Licensed under Apache-2.0.",
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "^[^\\\\:\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        {
          "not": {
            "pattern": "(^/|/$|//|(^|/)\\.{1,2}(/|$))"
          }
        }
      ]
    },
    "runtime_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^[^\\\\:\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        {
          "not": {
            "pattern": "(^/|/$|//|(^|/)\\.{1,2}(/|$))"
          }
        }
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(wwid:|serial:)[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "positive_bytes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
    },
    "ntfs_uuid": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^(?!0{16}$)[0-9A-F]{16}$(?![\\s\\S])"
    },
    "io_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_progress_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "failure_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "shutdown_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "transient_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "retry_delay_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "no_progress_seconds",
        "failure_grace_seconds",
        "shutdown_grace_seconds",
        "transient_retries",
        "retry_delay_ms"
      ]
    },
    "usb_device": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selection": {
              "const": "interactive"
            }
          },
          "required": [
            "selection"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selection": {
              "const": "identity"
            },
            "serial": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "capacity_bytes": {
              "$ref": "urn:crispawn:config:common:1#/$defs/positive_bytes"
            },
            "windows_device_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "selection",
            "serial",
            "model",
            "capacity_bytes"
          ]
        }
      ]
    },
    "ssid": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "encoding",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 44,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$(?![\\s\\S])"
            }
          },
          "required": [
            "encoding",
            "value"
          ]
        }
      ]
    },
    "wifi_profile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "urn:crispawn:config:common:1#/$defs/identifier"
            },
            "ssid": {
              "$ref": "urn:crispawn:config:common:1#/$defs/ssid"
            },
            "security": {
              "const": "open"
            },
            "hidden": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "ssid",
            "security",
            "hidden"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "urn:crispawn:config:common:1#/$defs/identifier"
            },
            "ssid": {
              "$ref": "urn:crispawn:config:common:1#/$defs/ssid"
            },
            "security": {
              "enum": [
                "wpa2_psk",
                "wpa3_sae"
              ]
            },
            "hidden": {
              "type": "boolean"
            },
            "credential_ref": {
              "$ref": "urn:crispawn:config:common:1#/$defs/identifier"
            }
          },
          "required": [
            "id",
            "ssid",
            "security",
            "hidden",
            "credential_ref"
          ]
        }
      ]
    },
    "ipv4_address": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "ipv4_assignment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {"method": {"const": "dhcp"}},
          "required": ["method"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {"const": "static"},
            "address": {"$ref": "#/$defs/ipv4_address"},
            "netmask": {"$ref": "#/$defs/ipv4_address"},
            "router": {"$ref": "#/$defs/ipv4_address"}
          },
          "required": ["method", "address", "netmask", "router"]
        }
      ]
    },
    "network": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "none"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "auto"
            },
            "wifi_profiles": {
              "type": "array",
              "items": {
                "$ref": "urn:crispawn:config:common:1#/$defs/wifi_profile"
              },
              "minItems": 0,
              "maxItems": 8
            }
          },
          "required": [
            "mode",
            "wifi_profiles"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"const": "ethernet"},
            "ipv4": {"$ref": "#/$defs/ipv4_assignment"}
          },
          "required": ["mode", "ipv4"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"const": "wifi"},
            "ipv4": {"$ref": "#/$defs/ipv4_assignment"},
            "country": {"type": "string", "pattern": "^[A-Z]{2}$", "minLength": 2, "maxLength": 2},
            "wifi_profile": {"$ref": "#/$defs/wifi_profile"}
          },
          "required": ["mode", "ipv4", "country", "wifi_profile"]
        }
      ]
    },
    "sources": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "all_internal"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "selected_ids"
            },
            "ids": {
              "type": "array",
              "items": {
                "$ref": "urn:crispawn:config:common:1#/$defs/stable_id"
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "ids"
          ]
        }
      ]
    },
    "volume": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "boot_disk_data"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "uuid"
            },
            "uuid": {
              "$ref": "urn:crispawn:config:common:1#/$defs/ntfs_uuid"
            }
          },
          "required": [
            "mode",
            "uuid"
          ]
        }
      ]
    },
    "smb_auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "anonymous"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "credential_ref"
            },
            "credential_ref": {
              "$ref": "urn:crispawn:config:common:1#/$defs/identifier"
            }
          },
          "required": [
            "mode",
            "credential_ref"
          ]
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "usb_disk"
            },
            "filesystem": {
              "const": "ntfs"
            },
            "volume": {
              "$ref": "urn:crispawn:config:common:1#/$defs/volume"
            },
            "backup_directory": {
              "$ref": "urn:crispawn:config:common:1#/$defs/runtime_path"
            }
          },
          "required": [
            "kind",
            "filesystem",
            "volume",
            "backup_directory"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "smb"
            },
            "server": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "share": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "backup_directory": {
              "$ref": "urn:crispawn:config:common:1#/$defs/runtime_path"
            },
            "authentication": {
              "$ref": "urn:crispawn:config:common:1#/$defs/smb_auth"
            }
          },
          "required": [
            "kind",
            "server",
            "share",
            "backup_directory",
            "authentication"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "s3"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "bucket": {
              "type": "string",
              "minLength": 3,
              "maxLength": 63,
              "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$(?![\\s\\S])"
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9-]+$(?![\\s\\S])"
            },
            "prefix": {
              "$ref": "urn:crispawn:config:common:1#/$defs/runtime_path"
            },
            "credential_ref": {
              "$ref": "urn:crispawn:config:common:1#/$defs/identifier"
            }
          },
          "required": [
            "kind",
            "endpoint",
            "bucket",
            "region",
            "prefix",
            "credential_ref"
          ]
        }
      ]
    },
    "startup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "auto_copy"
            },
            "delay_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            }
          },
          "required": [
            "mode",
            "delay_seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "menu"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "restore_select"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "poweroff"
            },
            "delay_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          },
          "required": [
            "action",
            "delay_seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "stay"
            }
          },
          "required": [
            "action"
          ]
        }
      ]
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "auto"
        },
        "initial_profile": {
          "enum": [
            "balanced",
            "long_matches",
            "high_compression",
            "incompressible"
          ]
        },
        "io_policy": {
          "$ref": "urn:crispawn:config:common:1#/$defs/io_policy"
        }
      },
      "required": [
        "mode",
        "initial_profile",
        "io_policy"
      ]
    },
    "target_pc": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "this_pc"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "generic"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "import_profile"
            },
            "profile_file": {
              "$ref": "urn:crispawn:config:common:1#/$defs/relative_path"
            }
          },
          "required": [
            "mode",
            "profile_file"
          ]
        }
      ]
    },
    "base": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "official"
            },
            "channel": {
              "const": "stable"
            },
            "architecture": {
              "const": "x86_64"
            },
            "release_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$(?![\\s\\S])"
            }
          },
          "required": [
            "source",
            "channel",
            "architecture"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "local_bundle"
            },
            "directory": {
              "$ref": "urn:crispawn:config:common:1#/$defs/relative_path"
            },
            "architecture": {
              "const": "x86_64"
            }
          },
          "required": [
            "source",
            "directory",
            "architecture"
          ]
        }
      ]
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "usb"
            },
            "device": {
              "$ref": "urn:crispawn:config:common:1#/$defs/usb_device"
            }
          },
          "required": [
            "kind",
            "device"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "iso"
            },
            "file": {
              "$ref": "urn:crispawn:config:common:1#/$defs/relative_path"
            },
            "boot_mode": {
              "const": "external_esp"
            }
          },
          "required": [
            "kind",
            "file",
            "boot_mode"
          ]
        }
      ]
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embed_credentials": {
          "type": "boolean"
        },
        "credentials_file": {
          "$ref": "urn:crispawn:config:common:1#/$defs/relative_path"
        }
      },
      "required": [
        "embed_credentials"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "embed_credentials": {
                "const": true
              }
            },
            "required": [
              "embed_credentials"
            ]
          },
          "then": {
            "required": [
              "credentials_file"
            ]
          }
        }
      ]
    },
    "credential": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "wifi_passphrase"
            },
            "passphrase": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            }
          },
          "required": [
            "type",
            "passphrase"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "smb_password"
            },
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "domain": {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            }
          },
          "required": [
            "type",
            "username",
            "password"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "s3_access_key"
            },
            "access_key_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "secret_access_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "session_token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "type",
            "access_key_id",
            "secret_access_key"
          ]
        }
      ]
    }
  }
}
