case "$1" in
    start)
        /usr/bin/perfect-backup-live </dev/null >/dev/ttyS0 2>&1 &
        echo "$!" >/run/perfect-backup-live.pid
        ;;
    stop)
        start-stop-daemon -K -q -p /run/perfect-backup-live.pid
        ;;
    *) exit 1 ;;
esac
