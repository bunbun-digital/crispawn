# SPDX-License-Identifier: Apache-2.0
CRISPAWN_LVGL_VERSION = 9.6.0
CRISPAWN_LVGL_SITE = $(call github,lvgl,lvgl,v$(CRISPAWN_LVGL_VERSION))
CRISPAWN_LVGL_SOURCE = lvgl-$(CRISPAWN_LVGL_VERSION).tar.gz
CRISPAWN_LVGL_LICENSE = MIT
CRISPAWN_LVGL_LICENSE_FILES = LICENCE.txt
CRISPAWN_LVGL_DEPENDENCIES = freetype libevdev host-pkgconf
CRISPAWN_LVGL_INSTALL_STAGING = YES
CRISPAWN_LVGL_SUPPORTS_IN_SOURCE_BUILD = NO
CRISPAWN_LVGL_CONF_OPTS = \
	-DBUILD_SHARED_LIBS=ON \
	-DLV_BUILD_CONF_PATH=$(BR2_EXTERNAL_CRISPAWN_PATH)/package/crispawn-lvgl/lv_conf.h \
	-DLV_BUILD_LVGL_H_SYSTEM_INCLUDE=ON \
	-DLV_BUILD_INSTALL=ON \
	-DLV_FETCH_DEPENDENCIES=OFF \
	-DCONFIG_LV_BUILD_DEMOS=OFF \
	-DCONFIG_LV_BUILD_EXAMPLES=OFF \
	-DCONFIG_LV_USE_THORVG=OFF \
	-DCONFIG_LV_USE_FREETYPE=ON \
	-DCONFIG_LV_USE_EVDEV=ON

define CRISPAWN_LVGL_INSTALL_LICENSE
	$(INSTALL) -D -m 0644 $(@D)/LICENCE.txt \
		$(TARGET_DIR)/usr/share/licenses/lvgl/LICENCE.txt
endef
CRISPAWN_LVGL_POST_INSTALL_TARGET_HOOKS += CRISPAWN_LVGL_INSTALL_LICENSE

$(eval $(cmake-package))
