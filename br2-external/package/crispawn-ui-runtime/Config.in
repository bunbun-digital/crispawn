config BR2_PACKAGE_CRISPAWN_UI_RUNTIME
    bool "crispawn-ui-runtime"
    depends on BR2_INSTALL_LIBSTDCPP
    depends on !BR2_STATIC_LIBS
    select BR2_PACKAGE_CRISPAWN_LVGL
    select BR2_PACKAGE_CRISPAWN_NOTO_SANS_JP
    help
      Shared OS UI initialization: framebuffer, keyboard focus, Japanese
      font and event processing. Applications use the upstream LVGL API.
